total=$((total+1)); echo "  TikTok: ${ttc:-无响应} (区域 ${ttr:-未知})"

cg=$(curl -s --max-time 8 'https://chat.openai.com/cdn-cgi/trace' 2>/dev/null | awk -F= '/^loc=/{print $2}')
if [[ -n "$cg" && "$cg" != "XX" && "$cg" != "T1" ]]; then passed=$((passed+1)); fi
total=$((total+1)); echo "  ChatGPT: ${cg:-不可达}"

bili_code() { curl -s --max-time 8 -A "$UA" "$1" 2>/dev/null | grep -oE '"code":[0-9]+' | head -1 | cut -d: -f2; }
bili=$(bili_code 'https://api.bilibili.com/pgc/player/web/playurl?avid=82846771&ep_id=307247&fnval=0')
[[ "$bili" == "0" ]] && bl="大陆" || { bili=$(bili_code 'https://api.bilibili.com/pgc/player/web/playurl?avid=18281381&ep_id=183799&fnval=0'); [[ "$bili" == "0" ]] && bl="港澳台"; }
if [[ -z "${bl:-}" ]]; then bili=$(bili_code 'https://api.bilibili.com/pgc/player/web/playurl?avid=50762638&ep_id=268176&fnval=0'); [[ "$bili" == "0" ]] && bl="台湾"; fi
[[ -n "${bl:-}" ]] && passed=$((passed+1)); total=$((total+1))
echo "  Bilibili: ${bl:-不可用}"

iq=$(curl -sI --max-time 8 -A "$UA" 'https://www.iq.com/' 2>/dev/null | grep -oE 'mod=[a-zA-Z]+' | head -1 | cut -d= -f2)
[[ -n "$iq" ]] && passed=$((passed+1)); total=$((total+1))
echo "  iQIYI: $([[ -n "$iq" ]] && echo "可用 (区域 ${iq})" || echo 不可用)"
[[ $total -gt 0 ]] && record media "$(( passed*10/total ))" "${passed}/${total} 项可用" "流媒体是用途不是机器质量；只在该场景权重里起作用"

pc=0; plist=()
for ep in '1.1.1.1:443:DNS-over-TLS' 'www.google.com:80:HTTP' 'smtp.gmail.com:25:SMTP'; do
  eh=${ep%%:*}; rest=${ep#*:}; epport=${rest%%:*}; elab=${rest##*:}
  if timeout 3 bash -c "echo >/dev/tcp/$eh/$epport" 2>/dev/null; then pc=$((pc+1)); plist+=("$elab✓"); else plist+=("$elab✗"); fi
