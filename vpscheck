#!/bin/bash
RED='\033[31m'; GREEN='\033[32m'; YELLOW='\033[33m'; BLUE='\033[34m'; NC='\033[0m'

# ==================== 评分标准显示函数 ====================
show_score_standard() {
    local score=$1
    local type=$2
    if [[ "$type" == "cpu" ]]; then
        if (( $(echo "$score >= 9" | bc -l 2>/dev/null) )); then echo "极强"
        elif (( $(echo "$score >= 7" | bc -l 2>/dev/null) )); then echo "良好"
        elif (( $(echo "$score >= 5" | bc -l 2>/dev/null) )); then echo "一般"
        else echo "较弱"; fi
    elif [[ "$type" == "disk" ]]; then
        if (( $(echo "$score >= 9" | bc -l 2>/dev/null) )); then echo "极速NVMe"
        elif (( $(echo "$score >= 7" | bc -l 2>/dev/null) )); then echo "高速NVMe"
        elif (( $(echo "$score >= 5" | bc -l 2>/dev/null) )); then echo "普通SSD"
        else echo "慢速盘"; fi
    elif [[ "$type" == "memory" ]]; then
        if (( $(echo "$score >= 9" | bc -l 2>/dev/null) )); then echo "充裕"
        elif (( $(echo "$score >= 7" | bc -l 2>/dev/null) )); then echo "够用"
        elif (( $(echo "$score >= 4" | bc -l 2>/dev/null) )); then echo "勉强"
        else echo "不足"; fi
    elif [[ "$type" == "network" ]]; then
        if (( $(echo "$score >= 9" | bc -l 2>/dev/null) )); then echo "优秀"
        elif (( $(echo "$score >= 7" | bc -l 2>/dev/null) )); then echo "良好"
        elif (( $(echo "$score >= 5" | bc -l 2>/dev/null) )); then echo "一般"
        else echo "较差"; fi
    elif [[ "$type" == "ip" ]]; then
        if (( $(echo "$score >= 9" | bc -l 2>/dev/null) )); then echo "优质IP"
        elif (( $(echo "$score >= 7" | bc -l 2>/dev/null) )); then echo "良好IP"
        elif (( $(echo "$score >= 5" | bc -l 2>/dev/null) )); then echo "普通IP"
        else echo "较差IP"; fi
    elif [[ "$type" == "route" ]]; then
        if (( $(echo "$score >= 9" | bc -l 2>/dev/null) )); then echo "直连精品"
        elif (( $(echo "$score >= 7" | bc -l 2>/dev/null) )); then echo "直连普通"
        elif (( $(echo "$score >= 5" | bc -l 2>/dev/null) )); then echo "混合线路"
        else echo "绕路"; fi
    elif [[ "$type" == "stream" ]]; then
        if (( $(echo "$score >= 9" | bc -l 2>/dev/null) )); then echo "全解锁"
        elif (( $(echo "$score >= 7" | bc -l 2>/dev/null) )); then echo "大部分解锁"
        elif (( $(echo "$score >= 4" | bc -l 2>/dev/null) )); then echo "部分解锁"
        else echo "基本不解锁"; fi
    fi
}

if ! command -v bc &> /dev/null; then
    apt install bc -y >/dev/null 2>&1 || yum install bc -y >/dev/null 2>&1
fi

echo -e "${BLUE}=========================================${NC}"
echo -e "${BLUE}   🧠 VPS 专业评分引擎 v5.5        ${NC}"
echo -e "${BLUE}   新增：显示CPU型号/磁盘设备        ${NC}"
echo -e "${BLUE}=========================================${NC}"

echo -e "\n${YELLOW}📟 [1/7] CPU 性能检测...${NC}"
if ! command -v sysbench &> /dev/null; then
    apt install sysbench -y >/dev/null 2>&1 || yum install sysbench -y >/dev/null 2>&1
fi

# 获取 CPU 型号
cpu_model=$(lscpu | grep "Model name" | head -1 | awk -F':' '{print $2}' | xargs)
if [[ -z "$cpu_model" ]]; then
    cpu_model=$(cat /proc/cpuinfo | grep "model name" | head -1 | awk -F':' '{print $2}' | xargs)
fi
echo -e "   CPU型号: ${cpu_model:-未知}"

sysbench cpu --threads=1 --time=5 run > /tmp/cpu_single.log 2>&1
single_score=$(grep "events per second:" /tmp/cpu_single.log | awk '{print $4}' | cut -d. -f1)
cores=$(nproc)
sysbench cpu --threads=$cores --time=5 run > /tmp/cpu_multi.log 2>&1
multi_score=$(grep "events per second:" /tmp/cpu_multi.log | awk '{print $4}' | cut -d. -f1)
[[ -z "$single_score" || "$single_score" == "0" ]] && single_score=800
[[ -z "$multi_score" || "$multi_score" == "0" ]] && multi_score=$((single_score * cores / 2))
if [[ $single_score -ge 1500 ]]; then sg=10; elif [[ $single_score -ge 1200 ]]; then sg=9; elif [[ $single_score -ge 900 ]]; then sg=7; elif [[ $single_score -ge 600 ]]; then sg=5; else sg=3; fi
ratio=$(echo "scale=2; $multi_score / $single_score" | bc)
if (( $(echo "$ratio >= 3.5" | bc -l) )); then mg=10; elif (( $(echo "$ratio >= 2.5" | bc -l) )); then mg=8; elif (( $(echo "$ratio >= 1.8" | bc -l) )); then mg=6; else mg=4; fi
cpu_score=$(echo "scale=1; $sg * 0.6 + $mg * 0.4" | bc)
echo -e "   单核: ${single_score}分 | 多核: ${multi_score}分 (${cores}核) -> ${cpu_score}/10"

echo -e "\n${YELLOW}💾 [2/7] 磁盘与内存性能检测...${NC}"

# ==================== 磁盘设备信息 ====================
root_dev=$(df -h / | tail -1 | awk '{print $1}')
if [[ -n "$root_dev" ]]; then
    dev_name=$(basename "$root_dev")
    if [[ "$dev_name" == vd* ]]; then
        dev_type="virtio"
    elif [[ "$dev_name" == nvme* ]]; then
        dev_type="nvme"
    elif [[ "$dev_name" == sd* ]]; then
        dev_type="sata/scsi"
    elif [[ "$dev_name" == xvd* ]]; then
        dev_type="xen"
    else
        dev_type="unknown"
    fi
    echo -e "   磁盘设备: $root_dev ($dev_type)"
else
    echo -e "   磁盘设备: 无法获取"
fi

# ==================== 磁盘性能测试 ====================
disk_score=0
iops="N/A"

if ! command -v fio &> /dev/null; then
    apt install fio -y >/dev/null 2>&1 || yum install fio -y >/dev/null 2>&1
fi

echo -e "   ${YELLOW}正在测试4K随机读写性能...${NC}"
fio_output=$(timeout 10 fio --name=4k_read --directory=/tmp --size=128M --bs=4k --rw=randread --ioengine=libaio --direct=1 --numjobs=1 --iodepth=32 --time_based --runtime=6 --group_reporting 2>&1)
fio_exit_code=$?
rm -f /tmp/4k_read* 2>/dev/null

if [[ $fio_exit_code -ne 0 ]] || [[ -z "$fio_output" ]]; then
    echo -e "   ${YELLOW}⚠️ fio 测试失败，磁盘得分 1 分${NC}"
    disk_score=1
    echo -e "   磁盘: 测试失败 -> ${disk_score}/10"
else
    iops_raw=$(echo "$fio_output" | grep -oE 'read:.*IOPS=[0-9.]+[kK]?' | head -1 | grep -oE '[0-9.]+[kK]?' | head -1)
    if [[ -n "$iops_raw" ]]; then
        if [[ "$iops_raw" =~ [kK]$ ]]; then
            iops_num=$(echo "$iops_raw" | sed 's/[kK]$//')
            iops=$(printf "%.0f" "$(echo "$iops_num * 1000" | bc 2>/dev/null)")
        else
            iops=$(printf "%.0f" "$iops_raw")
        fi
    fi
    if [[ -z "$iops" || "$iops" == "0" ]]; then
        iops=$(echo "$fio_output" | grep -oE 'iops[[:space:]]*:[[:space:]]*.*avg=[0-9.]+' | grep -oE 'avg=[0-9.]+' | head -1 | cut -d= -f2 | cut -d. -f1)
    fi

    if [[ -n "$iops" && "$iops" -gt 500 ]]; then
        if [[ $iops -ge 500000 ]]; then disk_score=10; disk_desc="极速NVMe(${iops} IOPS)"
        elif [[ $iops -ge 200000 ]]; then disk_score=9; disk_desc="高性能NVMe(${iops} IOPS)"
        elif [[ $iops -ge 80000 ]]; then disk_score=8; disk_desc="标准NVMe(${iops} IOPS)"
        elif [[ $iops -ge 30000 ]]; then disk_score=6; disk_desc="优秀SSD(${iops} IOPS)"
        elif [[ $iops -ge 10000 ]]; then disk_score=4; disk_desc="普通SSD(${iops} IOPS)"
        else disk_score=2; disk_desc="慢速盘(${iops} IOPS)"; fi
        echo -e "   4K随机读: ${iops} IOPS -> ${disk_score}/10 ($disk_desc)"
    else
        echo -e "   ${YELLOW}⚠️ 无法获取有效 IOPS，磁盘得分 1 分${NC}"
        disk_score=1
        echo -e "   磁盘: 无有效数据 -> ${disk_score}/10"
    fi
fi

# ==================== 内存检测 ====================
mem_total=$(free -m | awk '/Mem:/{print $2}')
if [[ -z "$mem_total" || "$mem_total" == "0" ]]; then
    mem_score=1
    mem_desc="无法检测(给最低分)"
else
    if [[ $mem_total -ge 14000 ]]; then mem_score=10; mem_desc="超大(≥16G)"
    elif [[ $mem_total -ge 7000 ]]; then mem_score=9; mem_desc="大内存(8G)"
    elif [[ $mem_total -ge 3500 ]]; then mem_score=7; mem_desc="充足(4G)"
    elif [[ $mem_total -ge 1800 ]]; then mem_score=5; mem_desc="够用(2G)"
    elif [[ $mem_total -ge 900 ]]; then mem_score=3; mem_desc="勉强(1G)"
    else mem_score=1; mem_desc="极小(<1G)"; fi
fi
echo -e "   内存: ${mem_total:-0}MB -> ${mem_score}/10 ($mem_desc)"

echo -e "\n${YELLOW}📍 [3/7] IP地理位置与类型...${NC}"
geo=$(curl -s --max-time 3 http://ip-api.com/json/)
if [[ -n "$geo" ]]; then
    country=$(echo "$geo" | grep -o '"country":"[^"]*"' | head -1 | cut -d'"' -f4)
    city=$(echo "$geo" | grep -o '"city":"[^"]*"' | head -1 | cut -d'"' -f4)
    isp=$(echo "$geo" | grep -o '"isp":"[^"]*"' | head -1 | cut -d'"' -f4)
    as_info=$(echo "$geo" | grep -o '"as":"[^"]*"' | head -1 | cut -d'"' -f4)
    country_code=$(echo "$geo" | grep -o '"countryCode":"[^"]*"' | cut -d'"' -f4)
    echo -e "   位置: $country - $city | 运营商: $isp"
    echo -e "   ASN信息: $as_info"
    
    # ---- 参考 ping0.cc 标准判断原生IP ----
    # 原理：WHOIS注册国家 == GeoIP定位国家 → 原生IP
    ip_type="未知"
    ip_bonus=0
    reg_country=""
    
    # 方式1：从 ipinfo.io 获取注册国（最准确）
    reg_country=$(curl -s --max-time 3 https://ipinfo.io/country 2>/dev/null)
    if [[ -n "$reg_country" && "$reg_country" == "$country_code" ]]; then
        ip_type="原生IP ✓ (注册国=$reg_country，定位国=$country_code)"
        ip_bonus=2
    elif [[ -n "$reg_country" && "$reg_country" != "$country_code" ]]; then
        ip_type="广播IP (注册国=$reg_country，定位国=$country_code)"
        ip_bonus=0
    else
        # 备选：从 as_info 中猜测
        as_org=$(echo "$as_info" | sed 's/^AS[0-9]* //')
        if echo "$as_org" | grep -qiE "HK|Hong Kong|Japan|Singapore|Korea|Taiwan|China|CN"; then
            if [[ "$country_code" == "HK" || "$country_code" == "JP" || "$country_code" == "SG" || "$country_code" == "KR" || "$country_code" == "TW" || "$country_code" == "CN" ]]; then
                ip_type="原生IP ✓ (ASN注册地与位置一致)"
                ip_bonus=2
            else
                ip_type="广播IP (ASN亚洲但位置在非亚洲)"
                ip_bonus=0
            fi
        else
            ip_type="未知 (无法确定注册国)"
            ip_bonus=0
        fi
    fi
    
    echo -e "   IP类型: $ip_type ($([ $ip_bonus -gt 0 ] && echo "+${ip_bonus}分" || echo "不加分"))"
    
    # 设置 region
    if [[ "$country" == "Hong Kong" || "$country" == "Japan" || "$country" == "Singapore" || "$country" == "South Korea" || "$country" == "Taiwan" ]]; then
        base_ip=9
        region="亚洲"
    elif [[ "$country" == "United States" ]]; then
        if [[ "$city" == "Los Angeles" || "$city" == "San Jose" || "$city" == "Seattle" ]]; then
            base_ip=7
            region="美西"
        else
            base_ip=5
            region="美东/中部"
        fi
    elif [[ "$country" == "Germany" || "$country" == "Netherlands" || "$country" == "United Kingdom" ]]; then
        base_ip=3
        region="欧洲"
    elif [[ "$country" == "Malaysia" || "$country" == "Vietnam" || "$country" == "Thailand" || "$country" == "Indonesia" || "$country" == "Philippines" ]]; then
        base_ip=6
        region="亚洲"
    else
        base_ip=5
        region="其他"
    fi
    
    score_ip=$((base_ip + ip_bonus))
    [[ $score_ip -gt 10 ]] && score_ip=10
    echo -e "   体质: ${score_ip}/10 ($region) [基础分:$base_ip + 类型加分:$ip_bonus]"
else
    country="未知"
    city="未知"
    isp="未知"
    country_code=""
    score_ip=5
    region="其他"
    ip_type="无法检测"
    echo -e "   ${YELLOW}⚠️ 无法获取IP地理位置信息，使用默认值${NC}"
fi

echo -e "\n${YELLOW}🌐 [4/7] 延迟 & TikTok解锁...${NC}"

echo -e "   ${YELLOW}正在测试到各地域的延迟...${NC}"
declare -A delay_nodes=(
    ["114DNS(全国)"]="114.114.114.114"
    ["中科院(北京)"]="159.226.8.6"
    ["百度(全国CDN)"]="www.baidu.com"
    ["北京联通(北京)"]="123.123.123.123"
    ["腾讯云(全国Anycast)"]="119.29.29.29"
    ["阿里云(全国Anycast)"]="223.5.5.5"
)

all_latencies=()
delay_details=()

for name in "${!delay_nodes[@]}"; do
    ip="${delay_nodes[$name]}"
    ping_result=$(ping -c 1 -W 2 "$ip" 2>/dev/null | grep 'time=' | awk -F 'time=' '{print $2}' | cut -d ' ' -f1)
    if [[ -n "$ping_result" ]]; then
        lat=$(printf "%.1f" "$ping_result")
        all_latencies+=("$lat")
        delay_details+=("   ${name}: ${lat}ms")
    else
        delay_details+=("   ${name}: 超时")
    fi
done

echo -e "   ${GREEN}延迟测试结果:${NC}"
for detail in "${delay_details[@]}"; do
    echo -e "   $detail"
done

if [[ ${#all_latencies[@]} -gt 0 ]]; then
    sum=0
    for lat in "${all_latencies[@]}"; do
        sum=$(echo "$sum + $lat" | bc)
    done
    lat_int=$(echo "scale=0; $sum / ${#all_latencies[@]}" | bc)
else
    case "$region" in
        "亚洲") lat_int=60 ;;
        "美西") lat_int=180 ;;
        "美东/中部") lat_int=240 ;;
        "欧洲") lat_int=260 ;;
        *) lat_int=200 ;;
    esac
    echo -e "   ${YELLOW}⚠️ 所有节点均超时，使用估算延迟: ${lat_int}ms${NC}"
fi

case "$region" in
    "亚洲")
        if [[ $lat_int -le 60 ]]; then lat_score=10
        elif [[ $lat_int -le 100 ]]; then lat_score=8
        elif [[ $lat_int -le 150 ]]; then lat_score=6
        else lat_score=3; fi ;;
    "美西")
        if [[ $lat_int -le 150 ]]; then lat_score=10
        elif [[ $lat_int -le 180 ]]; then lat_score=8
        elif [[ $lat_int -le 220 ]]; then lat_score=6
        else lat_score=3; fi ;;
    "欧洲"|"美东/中部")
        if [[ $lat_int -le 200 ]]; then lat_score=10
        elif [[ $lat_int -le 250 ]]; then lat_score=8
        elif [[ $lat_int -le 300 ]]; then lat_score=6
        else lat_score=3; fi ;;
    *) lat_score=5 ;;
esac

echo -e "   ${GREEN}综合平均延迟: ${lat_int}ms (区域:$region) -> 得分: ${lat_score}/10${NC}"

echo -e "   ${YELLOW}TikTok检测中...${NC}"
tiktok_response=$(timeout 6 curl -sL --max-time 5 -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36" "https://www.tiktok.com/" 2>/dev/null)
if [[ -z "$tiktok_response" ]] || [[ "$tiktok_response" == *"timed out"* ]] || [[ "$tiktok_response" == *"curl: ("* ]]; then
    tiktok_score=2
    tiktok_region="无"
    echo -e "   ${YELLOW}⚠️ TikTok 请求超时或无法访问 (给基础分)${NC}"
else
    tiktok_code=$(echo "$tiktok_response" | head -1 | grep -o "HTTP/.*" | tail -1 | awk '{print $2}' || echo "000")
    if [[ -z "$tiktok_code" || "$tiktok_code" == "000" ]]; then
        tiktok_code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 "https://www.tiktok.com/" 2>/dev/null)
    fi
    tiktok_score=0
    tiktok_region="无"
    if [[ "$tiktok_code" == "200" ]]; then
        tiktok_region=$(echo "$tiktok_response" | grep -oE '"region":"[A-Z]{2,5}"' | head -1 | cut -d'"' -f4)
        if [[ -z "$tiktok_region" || "$tiktok_region" == "null" ]]; then
            tiktok_region=$(echo "$tiktok_response" | grep -oP '(?<=region":")[A-Z]{2,5}' | head -1)
        fi
        if [[ -n "$tiktok_region" ]]; then
            case "$tiktok_region" in
                ALISG|AWS|AZURE|GCP|CLOUDFLARE|UNKNOWN)
                    tiktok_region=""
                    ;;
            esac
        fi
        if [[ -n "$tiktok_region" && "$tiktok_region" != "null" && "$tiktok_region" != "undefined" ]]; then
            if [[ "$tiktok_region" == "US" || "$tiktok_region" == "JP" || "$tiktok_region" == "HK" || "$tiktok_region" == "KR" ]]; then
                tiktok_score=3
                echo -e "   ${GREEN}✅ TikTok: 解锁 $tiktok_region 区${NC}"
            else
                tiktok_score=1
                echo -e "   ${YELLOW}⚠️ TikTok: 解锁 $tiktok_region 区${NC}"
            fi
        else
            tiktok_score=2
            echo -e "   ${GREEN}✅ TikTok: 可访问 (区域未知)${NC}"
        fi
    else
        tiktok_score=0
        echo -e "   ${RED}❌ TikTok: 无法访问 (HTTP $tiktok_code)${NC}"
    fi
fi
[[ -z "$tiktok_score" ]] && tiktok_score=0
[[ -z "$tiktok_region" ]] && tiktok_region="无"

echo -e "\n${YELLOW}🚦 [5/7] 三网回程路由（多节点检测）...${NC}"
if ! command -v traceroute &> /dev/null; then
    echo -e "   ${YELLOW}正在安装 traceroute...${NC}"
    apt install traceroute -y >/dev/null 2>&1 || yum install traceroute -y >/dev/null 2>&1
fi

declare -A nodes=(
    ["北京电信"]="219.141.140.10"
    ["上海电信"]="202.96.209.133"
    ["广州电信"]="61.144.56.100"
    ["成都电信"]="61.139.2.69"
    ["北京联通"]="202.106.195.68"
    ["上海联通"]="210.22.97.1"
    ["广州移动"]="120.196.165.24"
    ["成都移动"]="211.137.96.205"
)

cn2gia_count=0; cn2gt_count=0; telecom_163=0; unicom_4837=0; mobile_cmi=0; detect_success=0; route_summary=()
echo -e "   ${YELLOW}正在检测多节点回程路由（尝试多种模式）...${NC}"
for node_name in "${!nodes[@]}"; do
    target_ip="${nodes[$node_name]}"
    route_output=""
    # 模式1：TCP 模式（端口80）
    route_output=$(timeout 8 traceroute -T -p 80 -m 15 "$target_ip" 2>/dev/null)
    # 模式2：如果 TCP 失败，尝试 ICMP 模式
    if [[ -z "$route_output" ]]; then
        route_output=$(timeout 8 traceroute -I -m 15 "$target_ip" 2>/dev/null)
    fi
    # 模式3：如果 ICMP 也失败，尝试 UDP 模式（使用非特权端口）
    if [[ -z "$route_output" ]]; then
        route_output=$(timeout 8 traceroute -U -p 33434 -m 15 "$target_ip" 2>/dev/null)
    fi
    # 模式4：如果都失败，尝试用 mtr 检测（如果有）
    if [[ -z "$route_output" ]] && command -v mtr &> /dev/null; then
        route_output=$(timeout 8 mtr -r -c 3 -m 15 "$target_ip" 2>/dev/null)
    fi
    if [[ -n "$route_output" ]]; then
        detect_success=$((detect_success + 1))
        if echo "$route_output" | grep -qiE "59\.43|CTGNET|CN2"; then
            if echo "$route_output" | grep -qiE "GIA"; then
                cn2gia_count=$((cn2gia_count + 1)); route_summary+=("${node_name}: CN2 GIA ✅")
            else
                cn2gt_count=$((cn2gt_count + 1)); route_summary+=("${node_name}: CN2 GT ✅")
            fi
        elif echo "$route_output" | grep -qiE "AS4837|4837|chinaunicom|CNC"; then
            unicom_4837=$((unicom_4837 + 1)); route_summary+=("${node_name}: 联通4837")
        elif echo "$route_output" | grep -qiE "AS9808|9808|CMI|AS58453|chinamobile|CMCC"; then
            mobile_cmi=$((mobile_cmi + 1)); route_summary+=("${node_name}: 移动CMI")
        elif echo "$route_output" | grep -qiE "202\.97|163"; then
            telecom_163=$((telecom_163 + 1)); route_summary+=("${node_name}: 电信163")
        else
            route_summary+=("${node_name}: 普通线路")
        fi
    else
        route_summary+=("${node_name}: 检测超时")
    fi
done

echo -e "   ${GREEN}检测结果摘要:${NC}"
for ((i=0; i<${#route_summary[@]} && i<6; i++)); do
    echo -e "     ${route_summary[$i]}"
done
if [[ ${#route_summary[@]} -gt 6 ]]; then
    echo -e "     ... 共 ${#route_summary[@]} 个节点"
fi

# 评分逻辑
if [[ $detect_success -eq 0 ]]; then
    route_score=5; route_desc="所有节点检测失败"
elif [[ $cn2gia_count -gt 0 ]]; then
    route_score=10; route_desc="CN2 GIA直连（${cn2gia_count}个节点）"
elif [[ $cn2gt_count -gt 0 ]] && [[ $telecom_163 -eq 0 ]] && [[ $unicom_4837 -eq 0 ]] && [[ $mobile_cmi -eq 0 ]]; then
    route_score=9; route_desc="纯CN2 GT直连（${cn2gt_count}个节点）"
elif [[ $cn2gt_count -gt 0 ]] && [[ $telecom_163 -gt 0 ]]; then
    route_score=7; route_desc="混合线路（CN2 GT + 电信163）"
