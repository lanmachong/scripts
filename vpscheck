echo -e "\n${B}=========================================${N}"
echo -e "${B} 分项结果${N}"
echo -e "${B}=========================================${N}"
printf "  %-14s %-8s %-40s %s\n" "指标" "得分" "测量值" "备注"
order=(cpu_single cpu_multi steal disk_rand disk_seq disk_cap mem net_latency net_loss net_bw route_cn ip_rep media ports)
for k in "${order[@]}"; do
  s=${SCORE[$k]:-}
  if [[ -z "$s" ]]; then printf "  ${D}%-14s %-8s %s${N}\n" "${NAME[$k]}" "N/A" "${RAW[$k]:-}";
  else printf "  %-14s %-8s %-40s %s\n" "${NAME[$k]}" "${s}/10" "${RAW[$k]:-}" "${NOTE[$k]:-}"; fi
done

echo -e "\n${B}=========================================${N}"
echo -e "${B} 场景评分（同一台机器，不同用途）${N}"
echo -e "${B}=========================================${N}"
declare -A PSCORE=() PCOVER=() PFLAG=()
best=""; bestv=-1
while IFS='|' read -r pname wlist; do
  [[ -z "$pname" ]] && continue
  num=""; den=""
  for spec in $wlist; do
    k=${spec%%:*}; w=${spec##*:}; v=${SCORE[$k]:-}
    [[ -z "$v" ]] && continue
    num="${num}+${w}*${v}"; den="${den}+${w}"
  done
  if [[ -z "$den" ]]; then
    printf "  %-10s %s\n" "$pname" "N/A — 无可用指标"; continue
  fi
  val=$(awk "BEGIN{printf \"%.1f\", (${num:1})/(${den:1})}")
  cov=${den:1}
  cov=$(awk "BEGIN{printf \"%.2f\", ${den:1}}")
  PSCORE[$pname]=$val; PCOVER[$pname]=$cov
  PFLAG[$pname]=0
  awk -v c="$cov" 'BEGIN{exit !(c<0.80)}' && PFLAG[$pname]=1
  if awk -v a="$val" -v b="$bestv" 'BEGIN{exit !(a>b)}'; then best=$pname; bestv=$val; fi
done < <(profiles)
for pname in "${!PSCORE[@]}"; do
  bar_n=$(awk -v v="${PSCORE[$pname]}" 'BEGIN{printf "%d", v*2}')
  bar=$(printf '%0.s█' $(seq 1 "$bar_n" 2>/dev/null))
  warn=""; (( PFLAG[$pname] )) && warn="  ${Y}[样本不足，别信]${N}"
  printf "  %-10s %s/10 %-22s 覆盖权重 %s%s\n" "$pname" "${PSCORE[$pname]}" "$bar" "${PCOVER[$pname]}" "$warn"
done

# 短板：按得分升序，列出有实测值的最低 3 项
